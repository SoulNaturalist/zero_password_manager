<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — CWE-311 / CWE-319 mitigation.

  - No cleartext (HTTP) traffic in any build.
  - Trust system CAs only (no user-installed CAs that could enable MITM).
  - Debug-only override allows HTTP to local dev loopback endpoints.

  Previously this file used a plain <domain-config> for localhost, which
  silently applied to RELEASE builds too — a user-controlled DNS override
  could resolve an attacker host to 127.0.0.1 and downgrade traffic to HTTP.
  Moving those domains under <debug-overrides> scopes the exception to
  android:debuggable="true" builds only.
-->
<network-security-config>

    <!-- All builds: HTTPS only, system CAs only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug builds ONLY: allow HTTP to local dev servers. -->
    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <domain includeSubdomains="false">localhost</domain>
            <domain includeSubdomains="false">10.0.2.2</domain>
            <domain includeSubdomains="false">127.0.0.1</domain>
        </domain-config>
    </debug-overrides>

</network-security-config>
